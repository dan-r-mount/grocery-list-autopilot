{
  "name": "grocery-list-autopilot",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @gla/api dev",
    "dev:web": "pnpm --filter @gla/web dev",
    "milk:resolve": "pnpm --filter @gla/api milk:resolve",
    "milk:push": "pnpm --filter @gla/api milk:push",
    "test:vault": "pnpm --filter @gla/api test:vault",
    "typecheck": "pnpm -r run typecheck",
    "playwright:install": "pnpm --filter @gla/api exec playwright install chromium",
    "tunnel": "bash scripts/mobile-tunnel.sh",
    "mobile": "bash scripts/dev-mobile.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
