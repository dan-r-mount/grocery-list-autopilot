# Optional runtime config only — never put Sainsbury's passwords or session cookies here.
# Retailer sessions are stored encrypted under data/sainsburys.vault after Pixel connect.
# Household passkeys live in data/household.json; cookie HMAC secret in data/session-secret.

SAINSBURYS_WRITE_ENABLED=false
KEEP_SYNC_ENABLED=false

# Optional push topic name (not a credential)
NTFY_TOPIC=

PORT=3001
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
